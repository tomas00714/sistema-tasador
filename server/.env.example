# ============================================
# Configuración de Base de Datos PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tasador
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================
# Configuración de la Aplicación
# ============================================
APP_NAME=Tasador API
APP_ENV=development
DEBUG=true

# URL base para enlaces de compartir. Debe terminar con el separador usado para el token.
# Producción (path limpio con barra final):
# SHARE_BASE_URL=https://tasador.app/compartir/
# Local con Live Server sirviendo la raíz del proyecto (compartir.html está en client/):
SHARE_BASE_URL=http://127.0.0.1:5500/client/compartir.html?token=

# ============================================
# Configuración CORS
# ============================================
CORS_ORIGINS=*

# ============================================
# Emails de administradores
# Los administradores se determinan únicamente por su email.
# Agregá tantos como necesites: ADMIN_EMAIL_1, ADMIN_EMAIL_2, etc.
# ============================================
ADMIN_EMAIL_1=
# ADMIN_EMAIL_2=
# ADMIN_EMAIL_3=

# ============================================
# Configuración Mercado Pago
# ============================================
# Access Token para autenticación con la API de Mercado Pago
# Obtener en: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=

# Public Key para el frontend (Checkout Bricks)
MP_PUBLIC_KEY=

# Secret para validación de webhooks (x-signature)
# Se genera automáticamente al configurar webhooks en el panel de Mercado Pago
MP_WEBHOOK_SECRET=

# Entorno: sandbox para pruebas, production para cobros reales
MP_ENVIRONMENT=sandbox

# Configuración del plan de suscripción
# Monto mensual del plan Pro
MP_PLAN_PRICE=10.0

# Moneda del plan (USD o ARS)
# NOTA: Probar en sandbox para confirmar si USD está soportado en Argentina
MP_PLAN_CURRENCY=USD
