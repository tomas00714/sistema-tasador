# ============================================
# Configuración de Base de Datos PostgreSQL
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tasador
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================
# Configuración de la Aplicación
# ============================================
APP_NAME=Tasador API
APP_ENV=development
DEBUG=true

# ============================================
# URLs públicas del frontend
# ============================================
# Base pública del frontend, usada para construir los links de solicitudes
# (solicitud.html?link=...) y de tasaciones compartidas (compartir.html?token=...).
# Producción:
# PUBLIC_APP_URL=https://sistema-tasador.vercel.app
# Local (Live Server sirviendo la raíz del proyecto; las páginas están en client/):
PUBLIC_APP_URL=http://127.0.0.1:5500/client

# Opcional: prefijo completo para links de compartir tasación (sobreescribe el
# derivado de PUBLIC_APP_URL). Debe terminar con el separador usado para el token.
# Producción: SHARE_BASE_URL=https://sistema-tasador.vercel.app/compartir.html?token=
# Local:      SHARE_BASE_URL=http://127.0.0.1:5500/client/compartir.html?token=

# ============================================
# Seguridad
# ============================================
# Clave para firmar los JWT. Obligatoria en producción: si falta con
# APP_ENV=production el backend no arranca. Generar un valor aleatorio largo.
JWT_SECRET_KEY=

# ============================================
# Configuración CORS
# ============================================
# Orígenes permitidos, separados por coma. Si no se define, se usa una lista
# por defecto que incluye el frontend de producción y localhost de desarrollo.
# Producción:
# CORS_ORIGINS=https://sistema-tasador.vercel.app

# ============================================
# Emails de administradores
# Los administradores se determinan únicamente por su email.
# Agregá tantos como necesites: ADMIN_EMAIL_1, ADMIN_EMAIL_2, etc.
# ============================================
ADMIN_EMAIL_1=
# ADMIN_EMAIL_2=
# ADMIN_EMAIL_3=

# ============================================
# Configuración Mercado Pago
# ============================================
# Access Token para autenticación con la API de Mercado Pago
# Obtener en: https://www.mercadopago.com.ar/developers/panel/app
MP_ACCESS_TOKEN=

# Public Key para el frontend (Checkout Bricks)
MP_PUBLIC_KEY=

# Secret para validación de webhooks (x-signature)
# Se genera automáticamente al configurar webhooks en el panel de Mercado Pago
MP_WEBHOOK_SECRET=

# Entorno: sandbox para pruebas, production para cobros reales
MP_ENVIRONMENT=sandbox

# Configuración del plan de suscripción
# Monto mensual del plan Pro
MP_PLAN_PRICE=10.0

# Moneda del plan (USD o ARS)
# NOTA: Probar en sandbox para confirmar si USD está soportado en Argentina
MP_PLAN_CURRENCY=USD

# ============================================
# Configuración Google OAuth 2.0
# Obtener credenciales en: https://console.cloud.google.com/apis/credentials
# ============================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Debe coincidir exactamente con el Authorized redirect URI de Google Cloud Console
GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/auth/google/callback
